# Copy to backend/.env (local) or .env (docker compose). Never commit real secrets.
ENVIRONMENT=development
# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Local development (SQLite file):
DATABASE_URL=sqlite:///./screening.db
# PostgreSQL (used by docker compose):
# DATABASE_URL=postgresql+psycopg://screening:CHANGE_ME@db:5432/screening
POSTGRES_PASSWORD=CHANGE_ME
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
